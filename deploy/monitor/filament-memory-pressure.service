[Unit]
Description=Report sustained host memory pressure before OOM

[Service]
Type=oneshot
User=root
# ExecStart is rewritten by install-timers.sh at install time to point at
# /usr/local/lib/filament-monitor, so production never runs from a git checkout.
ExecStart=/usr/bin/python3 /root/stunning-tribble/deploy/monitor/memory-pressure-monitor.py
SuccessExitStatus=0 1
