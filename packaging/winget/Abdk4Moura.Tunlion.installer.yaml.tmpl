# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.28.0.schema.json
PackageIdentifier: Abdk4Moura.Tunlion
PackageVersion: "@VERSION@"
InstallerType: zip
NestedInstallerType: portable
NestedInstallerFiles:
  # winget can attach a PortableCommandAlias to each nested file, but only
  # executables can be portable nested files; a managed .cmd launcher cannot
  # be one. Expose just the canonical tunlion alias here. `tl` is provided by
  # the release ZIP's tl.cmd and by scripts/install.ps1, not by winget.
  - RelativeFilePath: tunlion.exe
    PortableCommandAlias: tunlion
Installers:
  - Architecture: x64
    InstallerUrl: https://github.com/Abdk4Moura/tunlion/releases/download/cli-v@VERSION@/tunlion-x86_64-pc-windows-msvc.zip
    InstallerSha256: "@SHA_WINDOWS@"
ReleaseDate: "@RELEASE_DATE@"
ManifestType: installer
ManifestVersion: 1.28.0
